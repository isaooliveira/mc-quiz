# Copie para .env.local e preencha.
# Sem estas variáveis o app roda em MODO DEV: calcula o resultado no cliente
# e apenas loga o lead no console (nada é gravado).

# URL do projeto Supabase (ex: https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Chave pública (anon) do projeto Supabase — usada só como bearer para chamar a Edge Function
VITE_SUPABASE_ANON_KEY=

# ID de medição do GA4 (só dispara em produção)
VITE_GA_ID=G-Y98DTB03J4

# Destino do botão final antes de 13/set (oferta quiz R$67).
# Em `npm run dev`, se esta variável não existir, o botão vai para
# http://localhost:5174/eap/#quiz-67 (landing local).
# Depois do dia 12/set o quiz vai sozinho para o checkout de acesso imediato (R$127).
# VITE_EAP_URL=https://www.missaoconsciencia.com.br/eap#quiz-67
